# YouTube API
YOUTUBE_API_KEY=...
# Optional: OAuth token JSON for captions on videos you own/manage. Keep this file private.
YOUTUBE_OAUTH_TOKEN_FILE=

# OpenAI
OPENAI_API_KEY=...

# Anthropic
ANTHROPIC_API_KEY=...

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vector Database
CHROMA_DB_PATH=./data/chroma_db

# Application Settings
SHOULD_LOCAL_EMBED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Settings
LLM_MODEL=gpt-4

# LLM Provider
LLM_PROVIDER=openai

# Retrieval Settings
RETRIEVAL_K=5

# Logging
LOG_LEVEL=INFO
