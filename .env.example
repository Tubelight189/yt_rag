# YouTube API

YOUTUBE_API_KEY=...


GEMINI_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash

# Vector Database
CHROMA_DB_PATH=./data/chroma_db

# Application Settings
SHOULD_LOCAL_EMBED=true
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM Settings
# LLM_MODEL=gpt-4
LLM_MODEL=gpt-4o-mini

# LLM Provider
LLM_PROVIDER=gemini

# Retrieval Settings
RETRIEVAL_K=5

# Logging
LOG_LEVEL=INFO
